{
  "name": "traslados",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch",
    "e2e": "playwright test",
    "emuladores": "firebase emulators:start --only firestore --project demo-traslados",
    "start:firestore": "ng serve --configuration firestore",
    "test:reglas": "firebase emulators:exec --only firestore --project demo-traslados \"vitest run --config vitest.reglas.config.ts\"",
    "e2e:firestore": "playwright test --config playwright.firestore.config.ts"
  },
  "private": true,
  "packageManager": "npm@12.0.1",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@capacitor/core": "8.6",
    "@ionic/angular": "9.0",
    "firebase": "13.4",
    "ionicons": "^8.1.1",
    "maplibre-gl": "6.19",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@capacitor/cli": "8.6",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "1.65",
    "firebase-tools": "^15.37.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
